# Reproducible image for the optional FastAPI service layer (apis/).
#
# Same pinning approach as a base toolkit image: base pinned by digest (CPython
# 3.10), uv pinned to an exact release, uv.lock exact. On top of the toolkit it
# installs the `api` extra (fastapi / uvicorn / jinja2 / python-multipart) and
# serves the app with uvicorn in production mode (no --reload).
#
# Build:
#   docker build -f Dockerfile.api -t climate-toolkit-api .
# Run (GEE-backed routes also need the credential mount + GCP_PROJECT_ID):
#   docker run --rm -p 8000:8000 \
#     -e GCP_PROJECT_ID=your-project \
#     -v "$HOME/.config/earthengine:/home/app/.config/earthengine:ro" \
#     -v "$(pwd)/outputs:/app/outputs" \
#     climate-toolkit-api

FROM python:3.10-slim@sha256:e5300dc020a26a34a19337a57602955a2510e22abeb176edd6de6cd2cc927dd4 AS runtime

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    MPLBACKEND=Agg \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependency layer (toolkit + api extra) -- cached until the lockfile changes.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-install-project --extra api

# Project + service source.
COPY climate_toolkit ./climate_toolkit
COPY apis ./apis
RUN uv sync --locked --extra api

# Run as non-root. Earth Engine credentials mount at
# /home/app/.config/earthengine; generated plots persist under /app/outputs.
RUN useradd --create-home app \
    && mkdir -p /app/outputs/api \
    && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"

CMD ["uvicorn", "apis.main:app", "--host", "0.0.0.0", "--port", "8000"]
